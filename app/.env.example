# Tracksy Configuration
PUBLIC_DEMO_JSON_URL=https://huggingface.co/datasets/tracksy/synthetic-datasets/resolve/main/datasets/spotify/Streaming_History_Audio_2006_25000.json

# Base path the app is deployed under (drives Astro's `base`, see astro.config.mjs).
# Defaults to "/tracksy" when unset. Set to "/" for a root deployment.
# BASE_PATH=/tracksy

# --- Optional: Langfuse trace export (dev only) ---
# Leave unset and the export button in the Tracksy LLM devtools panel stays
# disabled; nothing else changes.
#
# NOT prefixed PUBLIC_ on purpose. Astro inlines PUBLIC_ variables into client
# code, and Langfuse's OTLP endpoint authenticates with the SECRET key — so the
# browser posts to a same-origin dev proxy and the credential never leaves the
# dev server.
#
# Base URL is a Langfuse Cloud region, or a self-hosted host:
# LANGFUSE_BASE_URL=https://cloud.langfuse.com    # EU (default region)
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com # US
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
#
# Whether prompts/completions are sent along with the rest of a span is a
# tri-state, because the safe default depends on where they're going:
#   unset   -> auto: strip content iff LANGFUSE_BASE_URL is not local
#              (this is the default, and the one you want for Cloud)
#   "true"  -> always send content — only for deliberate use on synthetic data
#   "false" -> always strip, even against a local instance
# LANGFUSE_EXPORT_CONTENT=
